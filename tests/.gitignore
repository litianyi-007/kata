# Auto-regenerated by tests/build_fixture.py
fixture/

# Scratch dirs created by tests/run_smoke.py during runs
_config/
_images/
_xfield/
_watch/
_lint/
_init/
_resolver/

# Dreamer outputs land in a `dreaming/` subdir at runtime — exclude from
# any fixture so we don't accidentally commit a sample run.
dreaming_fixtures/*/dreaming/

# Per-run watermark mutations to log.md happen during eval; the build
# script regenerates log.md from spec, so changes here are spurious. We
# DO commit the fixture's pristine log.md (build_dreaming_fixture.py
# writes it deterministically) but ignore in-place mutations.
