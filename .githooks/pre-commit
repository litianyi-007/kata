#!/usr/bin/env bash
# kata pre-commit hook — run smoke tests + drift check on every commit.
#
# Enable once per clone:
#     git config --local core.hooksPath .githooks
#
# Disable temporarily:
#     git commit --no-verify ...
#
# Skip if no Python on this machine.
set -e

# Detect a working Python (Windows ships a Microsoft Store stub at
# python.exe that exists per `command -v` but fails on execution; --version
# probe filters those out).
PYTHON=""
for candidate in python3 python py; do
    if command -v "$candidate" >/dev/null 2>&1; then
        if [ "$candidate" = "py" ]; then
            "$candidate" -3 --version >/dev/null 2>&1 && PYTHON="$candidate -3" && break
        else
            "$candidate" --version >/dev/null 2>&1 && PYTHON="$candidate" && break
        fi
    fi
done

if [ -z "$PYTHON" ]; then
    echo "[pre-commit] No working Python found — skipping kata checks" >&2
    exit 0
fi

# Only run if any of the relevant paths changed in this commit.
RELEVANT_PATHS='^(plugin/scripts/|plugin/skills/|schema/|tests/|scripts/|SKILL\.md$|CHANGELOG\.md$)'
if ! git diff --cached --name-only | grep -qE "$RELEVANT_PATHS"; then
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# ============================================================
# Stage 0 — Compliance blocklist scan
# Rejects the commit if any staged content OR the would-be author
# identity (name + email) matches a blocklist pattern. Runs FIRST
# so we fail fast and never run expensive checks on a commit that's
# going to be rejected anyway.
# Bypass with: git commit --no-verify (use sparingly)
# ============================================================
BLOCKLIST=".compliance-blocklist.txt"
if [ -f "$BLOCKLIST" ]; then
    echo "[pre-commit] compliance scan…"
    # --no-renames: rename pairs show as add+delete so we catch the +added side.
    # Exclude the blocklist file itself (it contains the patterns by definition).
    # -U0: only changed lines, no context. grep '^\+' but not '^\+\+\+' (file header).
    diff_added=$(git diff --cached --no-color --no-renames -U0 \
        -- . ":(exclude)$BLOCKLIST" \
        | grep -E '^\+' | grep -vE '^\+\+\+' || true)

    # Stage 0a: scan the author identity that this commit will use. The diff
    # scan above only sees file content, so a corp-email author header slips
    # through. We treat author/committer name+email as if they were a +line.
    # Format: "Name <email>" — same shape as a git log %an <%ae> token.
    author_ident=$(git var GIT_AUTHOR_IDENT 2>/dev/null | sed -E 's/ [0-9]+ [-+][0-9]{4}$//' || true)
    committer_ident=$(git var GIT_COMMITTER_IDENT 2>/dev/null | sed -E 's/ [0-9]+ [-+][0-9]{4}$//' || true)

    # Concatenate into a single block for unified pattern scanning. Prefix
    # each line with "+author:" / "+committer:" so violation reports tell
    # you which field tripped the rule, not just the matched pattern.
    identity_block=""
    [ -n "$author_ident" ] && identity_block="${identity_block}+author: ${author_ident}
"
    [ -n "$committer_ident" ] && [ "$committer_ident" != "$author_ident" ] \
        && identity_block="${identity_block}+committer: ${committer_ident}
"

    scan_target="${diff_added}
${identity_block}"

    if [ -n "$scan_target" ]; then
        violations=""
        while IFS= read -r line; do
            # Strip inline comments and trim whitespace
            pattern=$(printf '%s' "$line" | sed -E 's/[[:space:]]*#.*$//' | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')
            [ -z "$pattern" ] && continue

            hit=$(printf '%s\n' "$scan_target" | grep -E -e "$pattern" || true)
            if [ -n "$hit" ]; then
                sample=$(printf '%s\n' "$hit" | head -1 | cut -c1-120)
                violations="$violations
    [pattern] $pattern
    [match]   $sample
"
            fi
        done < "$BLOCKLIST"

        if [ -n "$violations" ]; then
            echo >&2
            echo "[pre-commit] BLOCKED — compliance violations in staged content or author identity:" >&2
            printf '%s\n' "$violations" >&2
            echo "[pre-commit] If the match is on +author: or +committer:, fix git config:" >&2
            echo "[pre-commit]   git config --local user.email <public-email>" >&2
            echo "[pre-commit]   git config --local user.name  <public-name>" >&2
            echo "[pre-commit] If this is a false positive, edit $BLOCKLIST." >&2
            echo "[pre-commit] If genuinely intentional, override once with: git commit --no-verify" >&2
            exit 1
        fi
    fi
    echo "[pre-commit] compliance OK (content + author identity)."
fi

# Force Python UTF-8 mode for the smoke + drift checks. Matches the
# windows-latest CI workflow env (PYTHONUTF8=1) so a hook pass locally on
# any locale (cp936, cp1252, …) lines up with what CI will see.
export PYTHONUTF8=1

echo "[pre-commit] checking SKILL.md drift…"
$PYTHON scripts/build_skill_md.py --check || {
    echo "[pre-commit] SKILL.md drift detected. Run: python scripts/build_skill_md.py" >&2
    exit 1
}

echo "[pre-commit] running smoke tests…"
$PYTHON tests/run_smoke.py || {
    echo "[pre-commit] smoke tests failed. Fix or commit with --no-verify." >&2
    exit 1
}

echo "[pre-commit] all checks passed."
