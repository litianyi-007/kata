# Claude Code session-local settings (user-machine-specific)
.claude/settings.local.json

# Claude Code project MCP server config (contains absolute machine paths;
# per-user, not portable across machines / CI).
.mcp.json

# Auto-generated session transcripts (Claude Code recovery)
20*-*-this-session-is-being-continued-from-*.txt

# Python bytecode (scripts/ and tests/ are stdlib but may be compiled)
__pycache__/
*.pyc
*.pyo

# Scratch JSON written by smoke / eval scripts
_tmp_dream*.json

# Test fixtures are regenerated by tests/build_fixture.py
tests/fixture/

# Per-test scratch dirs that run_smoke.py creates and overwrites on every
# run (_watch_multi, _dream_apply, _init_dream, _config, _init, _lint,
# _resolver, _watch, _xfield, _images). Checking them in just bloats
# diffs. Pattern matches both the new ones from the 2026-05-07 audit
# follow-up and the older ones from prior rounds.
tests/_*/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
.obsidian/

# Local plugin manifest (per-user, may contain absolute paths and tokens)
.wiki-plugins.yaml

# Working artifacts NOT part of the plugin release.
# These live in the repo root only because the original session generated
# them; they're not consumed by Claude Code, Codex CLI, or the standalone
# prompt path. Decide later whether to move them into a docs/ subdir or
# delete them.
/presentation.html
/speech-notes.md

# Compliance audit reports — internal governance artifacts. Original
# audits keep the un-redacted strings as audit-trail evidence and would
# defeat the redaction if pushed publicly. File them into the ak-wiki
# self-meta wiki instead (~/.llm-wiki/ak-wiki/raw/external/).
docs/compliance-audit-*.md
